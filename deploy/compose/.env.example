# Copy to .redteam/.env (which `redteam init` does for you) and fill in what your runs need.
# Every value is optional: the mock target checks nothing, and a run naming a hosted model is
# refused at the gate until its key is here.
TARGET_KEY=mock-target-checks-nothing
OPENROUTER_API_KEY=
ALQUIMIA_API_TOKEN=
BRAIN_REGISTRY_CREDENTIALS=
# Ports, if the defaults collide with something on this machine.
# REDTEAM_API_PORT=8080
# REDTEAM_TARGET_PORT=8082
# REDTEAM_RECEIVER_PORT=8083
# REDTEAM_MINIO_PORT=9000
