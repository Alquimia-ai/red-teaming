# red-teaming-runner
#
# GENERATED by scripts/render_dockerfiles.py -- edit that, not this.
#
# One run, to completion, then exit. The only image where generation and conduction
# meet: it carries the knowledge client, the judges, the target adapters and the
# engine, and serves no HTTP.
#
# Built from the repository root: the workspace resolves as one lock, and only this app's
# dependency closure is copied in. What is absent from the image is a structural guarantee, not a
# convention.
FROM python:3.12-slim

LABEL org.opencontainers.image.source="https://github.com/Alquimia-ai/red-teaming" \
      org.opencontainers.image.title="red-teaming-runner" \
      org.opencontainers.image.description="The red-teaming runner: one run, from generation to manifest"

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:0.7.10 /uv /uvx /usr/local/bin/

# Manifests first, in their own layer, so dependency resolution caches independently of source
# edits.
COPY pyproject.toml uv.lock ./
COPY apps/runner/pyproject.toml apps/runner/
COPY packages/catalogue/pyproject.toml packages/catalogue/
COPY packages/contracts/pyproject.toml packages/contracts/
COPY packages/delivery/pyproject.toml packages/delivery/
COPY packages/engine/pyproject.toml packages/engine/
COPY packages/judges/pyproject.toml packages/judges/
COPY packages/knowledge/pyproject.toml packages/knowledge/
COPY packages/probes/pyproject.toml packages/probes/
COPY packages/secrets/pyproject.toml packages/secrets/
COPY packages/settings/pyproject.toml packages/settings/
COPY packages/store/pyproject.toml packages/store/
COPY packages/target/pyproject.toml packages/target/

RUN uv sync --frozen --package red-teaming-runner --no-dev --no-install-workspace

# Then the sources for the workspace members this app actually uses.
COPY apps/runner/src/ apps/runner/src/
COPY packages/catalogue/src/ packages/catalogue/src/
COPY packages/contracts/src/ packages/contracts/src/
COPY packages/delivery/src/ packages/delivery/src/
COPY packages/engine/src/ packages/engine/src/
COPY packages/judges/src/ packages/judges/src/
COPY packages/knowledge/src/ packages/knowledge/src/
COPY packages/probes/src/ packages/probes/src/
COPY packages/secrets/src/ packages/secrets/src/
COPY packages/settings/src/ packages/settings/src/
COPY packages/store/src/ packages/store/src/
COPY packages/target/src/ packages/target/src/

RUN uv sync --frozen --package red-teaming-runner --no-dev

# Nothing here runs as root: the process writes to the store over the network and to nowhere on
# disk it does not own.
RUN groupadd --gid 1000 redteam && useradd --uid 1000 --gid 1000 --create-home redteam
USER redteam
ENV PATH="/app/.venv/bin:$PATH"

ENTRYPOINT ["redteam-runner"]
