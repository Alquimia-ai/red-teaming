# Combined API and subprocess runner for the single-service Railway deployment.
# Build from the repository root; the standalone app images remain unchanged.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:0.7.10 /uv /uvx /usr/local/bin/

COPY pyproject.toml uv.lock ./
COPY apps/ apps/
COPY packages/ packages/
RUN uv sync --frozen --all-packages --no-install-package red-teaming-cli --no-dev

RUN groupadd --gid 1000 redteam && useradd --uid 1000 --gid 1000 --create-home redteam
USER redteam
ENV PATH="/app/.venv/bin:$PATH"
RUN python -c "import redteam_api, redteam_runner"

EXPOSE 8080
CMD ["uvicorn", "redteam_api.main:app", "--host", "0.0.0.0", "--port", "8080"]
